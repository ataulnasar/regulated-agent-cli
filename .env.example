# Which model provider to use: fake (offline, default) | anthropic | bedrock
LLM_PROVIDER=fake

# Anthropic API (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-5

# AWS Bedrock (only needed when LLM_PROVIDER=bedrock). eu-north-1 keeps data in Stockholm.
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=
